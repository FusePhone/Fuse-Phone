{
  "id": "com.fusephone.crm",
  "name": "Fuse Phone - CRM for Contractors",
  "short_name": "Fuse Phone",
  "description": "Stop losing leads. Fuse Phone answers calls 24/7, sends proposals, automates follow-ups, and gets you paid — so you can focus on the job, not the phone. Built by a painter, for painters and home services pros.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#232d3b",
  "theme_color": "#1e40af",
  "categories": ["business", "productivity"],
  "lang": "en-US",
  "dir": "ltr",
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": true,
  "related_applications": [
    {
      "platform": "itunes",
