      "id": "id6743428729"
    },
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.fusephone.crm",
      "id": "com.fusephone.crm"
    },
    {
      "platform": "webapp",
      "url": "https://app.fusephone.com/manifest.json"
    }
  ],
